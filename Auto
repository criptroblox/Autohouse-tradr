-- Функция отправки сообщения в чат
local function sendToChat(message)
    if message == "" then return end
    
    -- Способ 1: Через DefaultChatSystemChatEvents
    local chatEvent = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if chatEvent then
        local sayMessageRequest = chatEvent:FindFirstChild("SayMessageRequest")
        if sayMessageRequest then
            sayMessageRequest:FireServer(message, "All")
            print("Sent: " .. message)
            return
        end
    end
    
    -- Способ 2: Через ChatRemote
    local chatRemote = game:GetService("ReplicatedStorage"):FindFirstChild("ChatRemote")
    if chatRemote then
        chatRemote:FireServer(message)
        print("Sent: " .. message)
        return
    end
    
    -- Способ 3: Через TextChatService
    local textChatService = game:GetService("TextChatService")
    if textChatService and textChatService.ChatInputBarConfiguration then
        local textChannels = textChatService:WaitForChild("TextChannels")
        local generalChannel = textChannels:WaitForChild("RBXGeneral")
        if generalChannel then
            generalChannel:SendAsync(message)
            print("Sent: " .. message)
            return
        end
    end
    
    print("Failed to send message!")
end

-- Обработчик кнопки Отправить
SendButton.MouseButton1Click:Connect(function()
    local text = TextBox.Text
    if text ~= "" then
        sendToChat(text)
        TextBox.Text = "" -- Очищаем поле после отправки
    end
end)

-- Отправка по Enter
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = TextBox.Text
        if text ~= "" then
            sendToChat(text)
            TextBox.Text = ""
        end
    end
end)

