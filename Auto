-- Переменная для управления авто-отправкой
local autoSendActive = false

-- Функция отправки сообщения в чат
local function sendToChat(message)
    if message == "" then return false end
    
    -- Способ 1: Через DefaultChatSystemChatEvents
    local chatEvent = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    if chatEvent then
        local sayMessageRequest = chatEvent:FindFirstChild("SayMessageRequest")
        if sayMessageRequest then
            sayMessageRequest:FireServer(message, "All")
            print("Sent: " .. message)
            return true
        end
    end
    
    -- Способ 2: Через ChatRemote
    local chatRemote = game:GetService("ReplicatedStorage"):FindFirstChild("ChatRemote")
    if chatRemote then
        chatRemote:FireServer(message)
        print("Sent: " .. message)
        return true
    end
    
    -- Способ 3: Через TextChatService
    local textChatService = game:GetService("TextChatService")
    if textChatService and textChatService.ChatInputBarConfiguration then
        local textChannels = textChatService:WaitForChild("TextChannels")
        local generalChannel = textChannels:WaitForChild("RBXGeneral")
        if generalChannel then
            generalChannel:SendAsync(message)
            print("Sent: " .. message)
            return true
        end
    end
    
    print("Failed to send message!")
    return false
end

-- Обработчик кнопки Старт/Стоп
StartStopButton.MouseButton1Click:Connect(function()
    autoSendActive = not autoSendActive
    
    if autoSendActive then
        -- Запускаем авто-отправку
        StartStopButton.Text = "⏹ СТОП"
        StartStopButton.BackgroundColor3 = Color3.fromRGB(220, 0, 0)
        StatusLabel.Text = "Статус: Авто-отправка..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        
        -- Запускаем цикл в отдельном потоке
        spawn(function()
            while autoSendActive do
                local text = TextBox.Text
                if text ~= "" then
                    sendToChat(text)
                end
                
                -- Получаем задержку из поля
                local delay = tonumber(DelayBox.Text) or 10
                if delay < 1 then delay = 1 end -- Минимальная задержка 1 сек
                
                wait(delay)
            end
        end)
    else
        -- Останавливаем авто-отправку
        StartStopButton.Text = "▶ СТАРТ"
        StartStopButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        StatusLabel.Text = "Статус: Остановлено"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    end
end)

-- Обработчик кнопки Отправить 1 раз
SendOnceButton.MouseButton1Click:Connect(function()
    local text = TextBox.Text
    if text ~= "" then
        sendToChat(text)
        StatusLabel.Text = "Статус: Отправлено 1 раз"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    end
end)

-- Отправка по Enter в поле сообщения
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = TextBox.Text
        if text ~= "" then
            sendToChat(text)
            StatusLabel.Text = "Статус: Отправлено 1 раз"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        end
    end
end)

