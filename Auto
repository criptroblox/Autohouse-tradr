-- Функция отправки сообщения в чат
local function sendChatMessage(msg)
    -- Способ для эксплоитов: через ReplicatedStorage
    local replicatedStorage = game:GetService("ReplicatedStorage")
    
    -- Пробуем найти DefaultChatSystemChatEvents
    local chatEvent = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if chatEvent then
        local sayMessageRequest = chatEvent:FindFirstChild("SayMessageRequest")
        if sayMessageRequest then
            sayMessageRequest:FireServer(msg, "All")
            print("Message sent: " .. msg)
            return
        end
    end
    
    -- Альтернативный способ через ChatRemote
    local chatRemote = replicatedStorage:FindFirstChild("ChatRemote")
    if chatRemote then
        chatRemote:FireServer(msg)
        print("Message sent via ChatRemote: " .. msg)
        return
    end
    
    print("Failed to send message: " .. msg)
end

-- Функция для установки Magic House Door
local function placeDoor()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    
    if not character then
        print("Character not found!")
        return
    end
    
    -- Попытка найти дверь в Backpack
    local backpack = player:WaitForChild("Backpack")
    local doorTool = backpack:FindFirstChild("Magic House Door")
    
    if doorTool then
        -- Активируем предмет
        doorTool.Parent = character
        wait(0.5)
        
        local tool = character:FindFirstChild("Magic House Door")
        if tool then
            tool:Activate()
            wait(0.5)
            print("Door placed!")
        end
    else
        print("Magic House Door not found in backpack!")
    end
end

-- Функция перемещения к двери
local function moveToDoor()
    local door = workspace:FindFirstChild("MagicHouseDoor") 
        or workspace:FindFirstChild("HouseDoor")
        or workspace:FindFirstChild("Door")
    
    if door and door:IsA("BasePart") then
        local player = game.Players.LocalPlayer
        local character = player.Character
        
        if character then
            local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
            if humanoidRootPart then
                local targetPos = door.Position + Vector3.new(0, 0, 3)
                humanoidRootPart.CFrame = CFrame.new(targetPos)
                print("Moved to the door.")
            end
        end
    else
        print("Door not found!")
    end
end

-- Основной цикл
local i = 0
while true do
    i = i + 1
    print("Cycle " .. i .. ": Starting...")
    
    -- 1. Пишем в чат
    sendChatMessage("trade house for good offer")
    wait(1)
    
    -- 2. Ставим дверь
    placeDoor()
    wait(1)
    
    -- 3. Перемещаемся к ней
    moveToDoor()
    
    -- Ждем 10 секунд
    wait(10)
end
