-- Переменные
local isRunning = false

-- Функция отправки в чат
local function sendToChat(message)
    if message == "" then return false end
    
    -- Пробуем разные методы
    local success = pcall(function()
        local chatEvent = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvent and chatEvent:FindFirstChild("SayMessageRequest") then
            chatEvent.SayMessageRequest:FireServer(message, "All")
            return
        end
        
        local chatRemote = game:GetService("ReplicatedStorage"):FindFirstChild("ChatRemote")
        if chatRemote then
            chatRemote:FireServer(message)
            return
        end
        
        local textChatService = game:GetService("TextChatService")
        if textChatService.ChatInputBarConfiguration then
            local generalChannel = textChatService.TextChannels:WaitForChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(message)
            end
        end
    end)
    
    return success
end

-- Отправка одного сообщения
SendOnceButton.MouseButton1Click:Connect(function()
    local text = TextBox.Text
    if text ~= "" then
        if sendToChat(text) then
            StatusLabel.Text = "Статус: Отправлено!"
            TextBox.Text = ""
        else
            StatusLabel.Text = "Статус: Ошибка отправки!"
        end
    end
end)

-- Авто-отправка
ToggleButton.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    
    if isRunning then
        ToggleButton.Text = "СТОП"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        StatusLabel.Text = "Статус: Авто-отправка..."
        
        -- Запускаем цикл авто-отправки
        spawn(function()
            while isRunning do
                local text = TextBox.Text
                if text ~= "" then
                    if sendToChat(text) then
                        StatusLabel.Text = "Статус: Отправлено!"
                    end
                end
                
                local delay = tonumber(DelayBox.Text) or 5
                wait(delay)
            end
        end)
    else
        ToggleButton.Text = "СТАРТ"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        StatusLabel.Text = "Статус: Остановлено"
    end
end)

-- Закрытие
CloseButton.MouseButton1Click:Connect(function()
    isRunning = false
    ScreenGui:Destroy()
end)
